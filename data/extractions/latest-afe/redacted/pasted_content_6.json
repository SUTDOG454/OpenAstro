  "definitions": {
    "economicTerms": [
      {
        "term": "Discounted benefits",
        "definition": "Future benefits from a project reduced to equivalent present values."
      },
      {
        "term": "Discounted costs",
        "definition": "Future costs of a project reduced to equivalent present values."
      },
      {
        "term": "Discounted realisable value",
        "definition": "The sum, reduced back to its equivalent present value, that could be realised by a business selling out at the end of its planning period."
      },
      {
        "term": "Discounted value of future profits",
        "definition": "Sum of profits during the firm's planning period with future profits reduced below their actual future values; a dollar available now is worth more than a dollar in the future."
      },
      {
        "term": "Equity",
        "definition": "The proportion of a firm's assets or capital belonging to the owner(s) of a business."
      },
      {
        "term": "Internal rate of return (IRR)",
        "definition": "Indicates the percentage rate of return on funds employed by a business or a project; takes into account the time-pattern of returns."
      },
      {
        "term": "Market transaction costs",
        "definition": "Costs involved in arranging market exchanges, including search, contracts, agency costs, etc."
      },
      {
        "term": "Nominal rate of interest",
        "definition": "The rate of interest payable, not adjusted for price inflation; tends to rise with inflation."
      },
      {
        "term": "Present discounted value",
        "definition": "The sum of money that, invested now, would accumulate with interest to a stated future sum."
      },
      {
        "term": "Real rate of interest",
        "definition": "The rate of interest reduced for price inflation; the greater the inflation, the larger the reduction."
      },
      {
        "term": "Spillovers (externalities)",
        "definition": "Side-effects of business activities for which no economic payment or costs are involved; can be favourable or unfavourable."
      },
      {
        "term": "Opportunity cost",
        "definition": "The economic benefit forgone by not choosing the best alternative to the choice actually made."
      },
      {
        "term": "Economic cost",
        "definition": "Actual costs plus opportunity costs."
      },
      {
        "term": "Minimum efficient scale (MES)",
        "definition": "The scale at which a business obtains its minimum cost per unit produced."
      },
      {
        "term": "Economies of scale",
        "definition": "Decreasing costs per unit of production as output increases, up to a point."
      },
      {
        "term": "Economies of scope",
        "definition": "Cost advantages from producing multiple products together."
      },
      {
        "term": "Economies of specialisation",
        "definition": "Advantages from focusing on a specific stage or product line."
      },
      {
        "term": "Gearing ratio (debt-equity)",
        "definition": "The ratio of a firm's debt to its equity; higher ratio indicates higher financial risk."
      },
      {
        "term": "Learning-by-doing",
        "definition": "Productivity improvements gained through experience over time."
      }
    ],
    "marketingCycleAdjustments": {
