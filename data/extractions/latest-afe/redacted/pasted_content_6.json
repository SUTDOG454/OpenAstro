  "formulas": {
    "macroScore": {
      "gdp": "if gdp >= 0.025 then 25; elif gdp >= 0.01 then 50 + (gdp - 0.01) * 50 / 0.015; else max(0, 50 * (gdp + 0.01) / 0.02)",
      "inflation": "if 0.01 <= inflation <= 0.03 then 25; elif inflation < 0.01 then 50 + inflation * 50; else max(0, 100 - (inflation - 0.03) * 15)",
      "interest": "if rate <= 0.02 then 25; elif rate <= 0.04 then 100 - (rate - 0.02) * 25; else max(0, 50 - (rate - 0.04) * 12.5)",
      "unemployment": "if unemp <= 0.05 then 25; elif unemp <= 0.07 then 100 - (unemp - 0.05) * 25; else max(0, 50 - (unemp - 0.07) * 12.5)"
    },
    "marketStructureScore": {
      "hhi": "if hhi < 1500 then 40; elif hhi < 2000 then 30; elif hhi < 2500 then 20; elif hhi < 3000 then 10; else 5",
      "lerner": "if lerner < 0.1 then 30; elif lerner < 0.2 then 25; elif lerner < 0.3 then 20; elif lerner < 0.4 then 15; elif lerner < 0.5 then 10; else 5",
      "entryBarriers": "if score <= 14 then 30; elif score <= 20 then 20; elif score <= 25 then 15; elif score <= 30 then 10; else 5"
    },
    "profitabilityScore": {
      "irrSpread": "if spread >= 0.05 then 50; elif spread >= 0.025 then 40; elif spread >= 0 then 30; elif spread >= -0.025 then 20; elif spread >= -0.05 then 10; else 5",
      "netMargin": "if margin >= 0.15 then 30; elif margin >= 0.10 then 25; elif margin >= 0.05 then 20; elif margin >= 0 then 15; else 5"
    },
    "competitionScore": {
      "hhiTrend": "falling -> 35; stable -> 25; rising -> 15",
      "lernerTrend": "rising -> 35; stable -> 25; falling -> 15",
      "entryRate": "if rate < 0.05 then 30; elif rate < 0.10 then 20; elif rate < 0.15 then 15; elif rate < 0.20 then 10; else 5"
    },
    "riskScore": {
      "gearing": "if <= 0.3 then 35; elif <= 0.5 then 28; elif <= 0.7 then 21; elif <= 1.0 then 14; elif <= 1.2 then 7; else 0",
      "fixedCosts": "if <= 0.3 then 35; elif <= 0.4 then 28; elif <= 0.5 then 21; elif <= 0.6 then 14; elif <= 0.7 then 7; else 0",
      "volatility": "if <= 0.1 then 30; elif <= 0.2 then 24; elif <= 0.3 then 18; elif <= 0.4 then 12; elif <= 0.5 then 6; else 0"
    },
    "normalize": "clamp((value - min) / (max - min), 0, 1)",
    "clamp": "max(minVal, min(maxVal, value))",
    "npv": "sum(CF_t / (1 + r)^t for t in 1..T) - I_0",
    "irr": "solve NPV = 0",
    "benefitCostRatio": "PV(Benefits) / PV(Costs)",
    "economicCost": "actualCosts + opportunityCosts",
    "elasticity": "(Q2 - Q1) / ((Q1 + Q2) / 2) / ((P2 - P1) / ((P1 + P2) / 2))",
    "hhi": "sum(s_i^2 for i in firms)",
    "lernerIndex": "(P - MC) / P",
    "conductParameter": "H = β1 + β2 + β3",
    "price": "AVC * (1 + markup)",
    "breakEven": "FC / (P - AVC)"
  },
